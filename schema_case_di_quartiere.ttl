# ================================================================
# Ontologia — Case di Quartiere di Bologna
#
# NAMESPACE bo: ancora placeholder — https://example.org/casediquartierebologna#
# ================================================================

@prefix bo:    <https://example.org/casediquartierebologna#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix cov:   <https://w3id.org/italia/onto/COV/> .
@prefix clv:   <https://w3id.org/italia/onto/CLV/> .
@prefix poi:   <https://w3id.org/italia/onto/POI/> .
@prefix ti:    <https://w3id.org/italia/onto/TI/> .
@prefix ac:    <https://w3id.org/italia/onto/AccessCondition/> .
@prefix sm:    <https://w3id.org/italia/onto/SM/> .
@prefix arco:  <https://w3id.org/arco/ontology/arco/> .
@prefix l0:    <https://w3id.org/italia/onto/l0/> .

# ----------------------------------------------------------------
# 1) CLASSI E PROPRIETÀ CUSTOM DEL PROGETTO (bo:)
# ----------------------------------------------------------------

<https://example.org/casediquartierebologna>
    a owl:Ontology ;
    rdfs:label "Ontologia Case di Quartiere di Bologna"@it .

bo:CasaDiQuartiere
    a owl:Class ;
    rdfs:subClassOf poi:PointOfInterest ;
    rdfs:label "Casa di Quartiere"@it ;
    rdfs:comment "Spazio comunitario gestito da associazioni del terzo settore, parte della rete istituzionale del Comune di Bologna."@it .

bo:isLocatedInHeritageBuilding
    a owl:ObjectProperty ;
    rdfs:domain bo:CasaDiQuartiere ;
    rdfs:range arco:ArchitecturalOrLandscapeHeritage ;
    rdfs:label "è ubicata nell'edificio storico"@it ;
    rdfs:comment "Collega una Casa di Quartiere al bene architettonico/paesaggistico ArCo che la ospita, indicato dalla colonna 'edificio_storico' del CSV."@it .

bo:isManagedBy
    a owl:ObjectProperty ;
    rdfs:domain bo:CasaDiQuartiere ;
    rdfs:range cov:PrivateOrganization ;
    rdfs:label "è gestita da"@it ;
    rdfs:comment "Collega una Casa di Quartiere all'organizzazione privata che la gestisce (colonna 'gestore' del CSV)."@it .

# ----------------------------------------------------------------
# 2) VOCABOLARIO DI RIFERIMENTO — proprietà/classi esterne da RIUSARE
#    (non ridichiarate: sono già definite nei rispettivi namespace
#    ufficiali OntoPiA/ArCo)
# ----------------------------------------------------------------

# --- Identificativo, nome, descrizione della Casa ---
# poi:POIID              [dominio: poi:PointOfInterest] [range: Literal]     — identificativo (colonna ed-casa)
# poi:POIofficialName    [dominio: poi:PointOfInterest] [range: Literal@it]  — nome ufficiale (colonna nome_casa)
# poi:POIdescription     [dominio: poi:PointOfInterest] [range: Literal@it]  — descrizione (colonna descrizione)

# --- Indirizzo (via, numero civico, quartiere, comune) ---
# clv:hasAddress          [dominio: owl:Thing]        [range: clv:Address]        — collega la Casa al suo indirizzo
# clv:hasStreetToponym    [dominio: clv:Address]      [range: clv:StreetToponym]  — collega l'indirizzo al nome della via
# clv:officialStreetName  [dominio: clv:StreetToponym][range: Literal@it]         — nome via, es. "Azzo Gardino"
# clv:toponymQualifier    [dominio: clv:StreetToponym][range: Literal@it]         — es. "Via", "Piazza", "Corso"
# clv:hasNumber           [dominio: clv:Address]      [range: clv:CivicNumbering] — collega l'indirizzo al civico (può ripetersi più volte sulla stessa Address)
# clv:streetNumber        [dominio: clv:CivicNumbering][range: xsd:int]           — parte numerica del civico
# clv:peculiarity         [dominio: clv:CivicNumbering][range: Literal]           — suffisso/lettera del civico (es. "A", "3"), quando presente
# clv:hasDistrict         [dominio: clv:Address]      [range: clv:District]       — collega l'indirizzo al quartiere
# clv:hasCity             [dominio: clv:Address]      [range: clv:City]           — collega l'indirizzo al comune
# rdfs:label              — su clv:District e clv:City: nessuna proprietà-nome dedicata in CLV, si usa rdfs:label@it come fallback

# --- Comune di Bologna: individuo UNICO, va riusato identico per tutte le 33 Case ---
# clv:hasIdentifier  [dominio: clv:City] [range: clv:Identifier]
# l0:identifier      [dominio: clv:Identifier] [range: Literal] — valore del codice, es. "037006" (ISTAT)
# clv:identifierType [dominio: clv:Identifier] [range: Literal] — es. "ISTAT"
# clv:issuedBy       [dominio: clv:Identifier] [range: cov:Organization]
# owl:sameAs         — clv:City del Comune di Bologna verso <http://www.wikidata.org/entity/Q1891>

# --- Geometria (coordinate) ---
# clv:hasGeometry [dominio: owl:Thing] [range: clv:Geometry]
# clv:lat         [dominio: clv:Geometry] [range: xsd:decimal]
# clv:long        [dominio: clv:Geometry] [range: xsd:decimal]

# --- Gestore ---
# cov:legalName      [dominio: cov:PrivateOrganization] [range: Literal@it] — ragione sociale (colonna gestore)
# cov:hasActivityType [dominio: cov:PrivateOrganization] [range: skos:Concept ATECO] — OPZIONALE, es. ateco-2025/94992

# --- Orari di apertura (una istanza per ogni cella non vuota del CSV) ---
# ac:hasAccessCondition [dominio: owl:Thing] [range: ac:OpeningHoursSpecification]
# ac:opens              [dominio: ac:OpeningHoursSpecification] [range: xsd:time] — es. "09:00:00"
# ac:closes             [dominio: ac:OpeningHoursSpecification] [range: xsd:time] — es. "13:00:00"
# ac:hasDayOfWeek        [dominio: ac:OpeningHoursSpecification] [range: ti:DayOfWeek] — usa gli individui fissi ti:Monday, ti:Tuesday, ti:Wednesday, ti:Thursday, ti:Friday, ti:Saturday, ti:Sunday

# --- Sito web ---
# sm:hasWebSite [dominio: owl:Thing] [range: sm:WebSite] — l'URL stesso è l'IRI dell'istanza sm:WebSite, nessun'altra proprietà dato

# --- Area verde / area ortiva (parco o orto che contiene la Casa) ---
# poi:isIncludedInPOI [dominio: poi:PointOfInterest] [range: poi:MultiplePointOfInterest]
# poi:hasPOICategory  [dominio: poi:PointOfInterest] [range: skos:Concept] — usa l'individuo fisso cat_2_recreation (categoria "Settore svago": giardini, parchi) del vocabolario <https://w3id.org/italia/controlled-vocabulary/poi-category-classification>
# poi:POIofficialName — anche sul parco/orto, per il suo nome proprio (se noto)

# --- Edificio storico (colonna 'edificio_storico' del CSV) ---
# bo:isLocatedInHeritageBuilding [dominio: bo:CasaDiQuartiere] [range: arco:ArchitecturalOrLandscapeHeritage] — collega la Casa al bene ArCo indicato dalla colonna 'edificio_storico' del CSV (vedi definizione sopra); genera la tripla solo per le righe in cui questa colonna non è vuota
