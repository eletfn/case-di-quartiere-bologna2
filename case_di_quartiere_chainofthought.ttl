@prefix poicat: <https://w3id.org/italia/controlled-vocabulary/poi-category-classification/> .

# ================================================================
# Individuo condiviso: Comune di Bologna (riusato da tutti gli indirizzi)
# ================================================================
bo:comuneBologna
    a clv:City ;
    rdfs:label "Bologna"@it ;
    clv:hasIdentifier bo:identifierBolognaISTAT ;
    owl:sameAs <http://www.wikidata.org/entity/Q1891> .

bo:identifierBolognaISTAT
    a clv:Identifier ;
    l0:identifier "037006" ;
    clv:identifierType "ISTAT" .

# ================================================================
# Individui condivisi: Quartieri (clv:District), uno per valore distinto
# ================================================================
bo:district_san_donato_san_vitale
    a clv:District ;
    rdfs:label "San Donato - San Vitale"@it .

bo:district_borgo_panigale_reno
    a clv:District ;
    rdfs:label "Borgo Panigale - Reno"@it .

bo:district_savena
    a clv:District ;
    rdfs:label "Savena"@it .

bo:district_navile
    a clv:District ;
    rdfs:label "Navile"@it .

bo:district_porto_saragozza
    a clv:District ;
    rdfs:label "Porto - Saragozza"@it .

bo:district_santo_stefano
    a clv:District ;
    rdfs:label "Santo Stefano"@it .

# ================================================================
# Individui condivisi: edifici storici catalogati in ArCo (solo 2 confermati)
# ================================================================
bo:VillaBernaroli
    a arco:ArchitecturalOrLandscapeHeritage ;
    rdfs:label "Villa Bernaroli"@it .

bo:VillaMazzacorati
    a arco:ArchitecturalOrLandscapeHeritage ;
    rdfs:label "Villa Mazzacorati"@it .

# Individuo condiviso: categoria POI "Settore svago" per parchi/orti
poicat:cat_2_recreation a skos:Concept .

# ================================================================
