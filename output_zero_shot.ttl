# ----------------------------------------------------------------
# Beni ArCo per gli edifici storici (edificio_storico = True)
# NB: gli IRI qui sotto sono PLACEHOLDER — vanno verificati/sostituiti
# con l'IRI reale ottenuto interrogando l'endpoint SPARQL di ArCo
# (dati.cultura.gov.it/sparql), come già fatto per il resto del progetto.
# ----------------------------------------------------------------
bo:villaBernaroliArco
    a arco:ArchitecturalOrLandscapeHeritage ;
    rdfs:label "Villa Bernaroli"@it .

bo:villaMazzacoratiArco
    a arco:ArchitecturalOrLandscapeHeritage ;
    rdfs:label "Villa Mazzacorati"@it .

