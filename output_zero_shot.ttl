# ================================================================
# Triple RDF (dati) — Case di Quartiere di Bologna
# Generato a partire da case_di_quartiere_cleaned(5).csv
# secondo l'ontologia bo: (schema_case_di_quartiere.ttl)
# ================================================================

@prefix bo:    <https://example.org/casediquartierebologna#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix cov:   <https://w3id.org/italia/onto/COV/> .
@prefix clv:   <https://w3id.org/italia/onto/CLV/> .
@prefix poi:   <https://w3id.org/italia/onto/POI/> .
@prefix ti:    <https://w3id.org/italia/onto/TI/> .
@prefix ac:    <https://w3id.org/italia/onto/AccessCondition/> .
@prefix sm:    <https://w3id.org/italia/onto/SM/> .
@prefix arco:  <https://w3id.org/arco/ontology/arco/> .
@prefix l0:    <https://w3id.org/italia/onto/l0/> .
@prefix poicat: <https://w3id.org/italia/controlled-vocabulary/poi-category-classification/> .

# ----------------------------------------------------------------
# Individuo unico: Comune di Bologna (riusato per tutte le Case)
# ----------------------------------------------------------------
bo:istat
    a cov:Organization ;
    rdfs:label "ISTAT - Istituto Nazionale di Statistica"@it .

bo:identificativoISTATBologna
    a clv:Identifier ;
    l0:identifier "037006" ;
    clv:identifierType "ISTAT" ;
    clv:issuedBy bo:istat .

bo:comuneBologna
    a clv:City ;
    rdfs:label "Bologna"@it ;
    clv:hasIdentifier bo:identificativoISTATBologna ;
    owl:sameAs <http://www.wikidata.org/entity/Q1891> .

# ----------------------------------------------------------------
# Distretti (clv:District) — un individuo per quartiere, riusato
# ----------------------------------------------------------------
bo:distretto_san-donato-san-vitale
    a clv:District ;
    rdfs:label "San Donato - San Vitale"@it .

bo:distretto_borgo-panigale-reno
    a clv:District ;
    rdfs:label "Borgo Panigale - Reno"@it .

bo:distretto_savena
    a clv:District ;
    rdfs:label "Savena"@it .

bo:distretto_navile
    a clv:District ;
    rdfs:label "Navile"@it .

bo:distretto_porto-saragozza
    a clv:District ;
    rdfs:label "Porto - Saragozza"@it .

bo:distretto_santo-stefano
    a clv:District ;
    rdfs:label "Santo Stefano"@it .

