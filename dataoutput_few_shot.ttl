# ================================================================
# Comune di Bologna (individuo unico, riusato da tutti gli indirizzi)
# ================================================================
bo:ComuneBologna
    a clv:City ;
    rdfs:label "Bologna"@it ;
    clv:hasIdentifier bo:Identifier_ComuneBologna ;
    owl:sameAs <http://www.wikidata.org/entity/Q1891> .

bo:Identifier_ComuneBologna
    a clv:Identifier ;
    l0:identifier "037006" ;
    clv:identifierType "ISTAT" ;
    clv:issuedBy bo:ISTAT .

bo:ISTAT
    a cov:Organization .


